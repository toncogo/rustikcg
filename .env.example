# Copie para .env e substitua os segredos antes de usar fora do desenvolvimento.
NODE_ENV=development

POSTGRES_DB=rustikcg
POSTGRES_USER=rustikcg
POSTGRES_PASSWORD=dev-only-change-this-database-password

JWT_SECRET=dev-only-change-this-to-a-random-secret-with-at-least-32-characters
TOKEN_PEPPER=dev-only-change-this-to-another-random-secret-with-at-least-32-characters
# Formatos suportados: inteiro seguido por s, m, h ou d.
JWT_EXPIRES_IN=1h
APP_ORIGIN=http://localhost:8080

# Para desenvolvimento, inicie com: docker compose --profile dev-mail up --build
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RustikCG <no-reply@rustikcg.local>"
